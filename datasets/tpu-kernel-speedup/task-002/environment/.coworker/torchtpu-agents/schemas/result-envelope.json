{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "additionalProperties": false,
   "properties": {
      "artifacts": {
         "items": {
            "type": "object"
         },
         "type": "array"
      },
      "errors": {
         "items": {
            "type": "object"
         },
         "type": "array"
      },
      "result": {
         "type": "object"
      },
      "status": {
         "enum": [
            "completed",
            "invalid_input",
            "needs_input",
            "failed"
         ],
         "type": "string"
      }
   },
   "required": [
      "status"
   ],
   "type": "object"
}
